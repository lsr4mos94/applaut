# Modelo do arquivo .env (copie para .env e preencha). Nunca envie o .env para o GitHub.

# --- Django
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# Ligue quando o site estiver em HTTPS
DJANGO_HTTPS=False
SITE_URL=http://app.lautbeer.com.br

# --- Banco do sistema (produção)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# --- Protheus
PROTHEUS_USER=
PROTHEUS_PASSWORD=
PROTHEUS_HOST=

# --- E-mail
EMAIL_PASSWORD=

# --- Zenvia (WhatsApp do plantão)
ZENVIA_API_TOKEN=
ZENVIA_REMETENTE=553190004411
ZENVIA_DESTINO_PLANTAO=5531998357400
ZENVIA_TEMPLATE_PLANTAO=358e7517-8beb-4161-af5f-8086fe7c6c91
# Mesma chave cadastrada na Zenvia para o webhook (cabeçalho X-API-KEY)
WEBHOOK_PLANTAO_TOKEN=

# --- Quem recebe cada e-mail (opcional; separados por vírgula). Sem estas linhas, valem os e-mails atuais.
# EMAILS_CADASTRO_CLIENTES=cadastroclientes@lautbeer.com.br
# EMAILS_COBRANCA=cobranca@lautbeer.com.br
