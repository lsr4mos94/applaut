# Agendamento de chopp: alerta de inadimplência
# Dias de atraso tolerados (0 = qualquer atraso) e valor vencido mínimo para alertar
INADIMPLENCIA_DIAS_ATRASO=0
INADIMPLENCIA_VALOR_MINIMO=0

# Agendamento / Chopp / Fábrica liberados para os usuários (False = ocultos; só o superusuário vê)
CHOPP_ATIVO=False
